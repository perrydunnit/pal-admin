# Copy to .env and fill in. .env is gitignored — never commit real secrets.
TZ=America/Denver
PALADMIN_HOSTNAME=pal-admin.example.com

# Game REST API (internal docker network, no TLS)
PAL_API=http://palworld-server:8212
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Container whose log carries join/leave events
PAL_CONTAINER=palworld-server
POLL_SECONDS=30

# Server config panel. The directory mount in compose.yaml points here, and the
# game's PalWorldSettings.ini is edited in place. Changes need the game image to
# stop regenerating that file from .env: set DISABLE_GENERATE_SETTINGS=true in
# the game stack's .env (see docs/PALWORLD-SERVER.md).
PAL_SETTINGS_FILE=/palconfig/PalWorldSettings.ini
PAL_SETTINGS_DIR=/opt/stacks/palworld/palworld/Pal/Saved/Config/LinuxServer

# Who may change settings or restart the game. Everyone who can reach the page
# still sees the values. Behind Traefik the client address comes from
# X-Forwarded-For, so this survives the proxy hop.
LAN_CIDRS=192.168.0.0/24
# A queued restart waits this long with nobody online before it fires.
RESTART_IDLE_SECONDS=300
RESTART_COUNTDOWN=30

# Uploaded music (dashboard -> /data/music by default) and the per-file cap.
# The cap is a policy/disk guard, not a memory limit: uploads are streamed.
MUSIC_DIR=/data/music
MUSIC_MAX_BYTES=268435456

# Request timeout for gunicorn. A slow upload counts against it, so raise this
# when raising MUSIC_MAX_BYTES much past 150 MB on a residential uplink.
GUNICORN_TIMEOUT=120

# Docker network shared with Traefik and the game server
TRAEFIK_NETWORK=media_default
